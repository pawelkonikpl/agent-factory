# Dev container image (devcontainer.json). Development only.
# The base image brings Python 3.12, git, make, curl and the non-root vscode user;
# devcontainer.json adds Node 22 as a feature.
FROM mcr.microsoft.com/devcontainers/python:1-3.12-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.9.10 /uv /bin/uv

# Use the image's Python and never download one; copy into .venv, since the uv cache
# and the bind-mounted checkout are on different filesystems.
ENV UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy
