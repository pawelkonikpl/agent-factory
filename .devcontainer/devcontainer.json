{
  "name": "OAuth BFF demo",
  "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "remoteUser": "vscode",
  // The redirect URI and the issuer are fixed to these localhost ports, so the
  // client must fail rather than forward them to other ports.
  "forwardPorts": [5173, 8080],
  "portsAttributes": {
    "5173": { "label": "web", "requireLocalPort": true },
    "8080": { "label": "Keycloak", "requireLocalPort": true }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
