# Copy to .env and adjust. Values match keycloak/realm-demo.json.
BFF_ISSUER=http://localhost:8080/realms/demo
BFF_CLIENT_ID=demo-bff
BFF_CLIENT_SECRET=demo-bff-secret-change-me
BFF_SCOPE=openid profile email
BFF_REDIRECT_URI=http://localhost:5173/bff/callback
BFF_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
BFF_APP_ORIGIN=http://localhost:5173
BFF_API_BASE_URL=http://localhost:8001
# Chrome and Firefox accept Secure cookies on http://localhost. Set to false only for
# browsers that do not (e.g. Safari); cookies then lose the __Host- prefix.
BFF_COOKIE_SECURE=true
