# BFF image for the local sandbox (compose.yaml). Development only.
FROM docker.io/library/python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.9.10 /uv /bin/uv

# Use the image's Python and never download one; compile bytecode at build time,
# since the non-root user cannot write __pycache__ next to the code.
ENV UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
COPY app ./app

RUN useradd --system --uid 10001 --no-create-home app
USER app

CMD ["/app/.venv/bin/uvicorn", "app.main:create_app", "--factory", "--port", "8000"]
