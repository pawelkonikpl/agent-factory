# Vite dev server image for the local sandbox (compose.yaml). Development only.
FROM docker.io/oven/bun:1.4.3-slim

# The bun user owns /app because Vite writes its dependency cache to node_modules/.vite.
WORKDIR /app
RUN chown bun:bun /app
USER bun

COPY --chown=bun:bun package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY --chown=bun:bun index.html tsconfig.json vite.config.ts ./
COPY --chown=bun:bun src ./src

CMD ["bun", "run", "dev", "--host", "0.0.0.0"]
