# Vite dev server image for the local sandbox (compose.yaml). Development only.
FROM docker.io/library/node:22-slim

# The node user owns /app because Vite writes its dependency cache to node_modules/.vite.
WORKDIR /app
RUN chown node:node /app
USER node

COPY --chown=node:node package.json package-lock.json ./
RUN npm ci
COPY --chown=node:node index.html tsconfig.json vite.config.ts ./
COPY --chown=node:node src ./src

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
